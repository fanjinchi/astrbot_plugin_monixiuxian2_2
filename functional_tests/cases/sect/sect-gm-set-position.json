{
  "name": "sect-gm-set-position",
  "description": "GM 指令「设置职位」：接受数字 0-4 与中文职位名，直接调整职阶；宗主职位晋升被拦截，职位对晋升目标门槛的判定即时生效。",
  "scenario": "GM 设置职位为 0（宗主）：我的宗门显示宗主、宗门晋升提示无需晋升；以中文名设置 亲传弟子 后晋升指向长老（贡献 30000/9 级）双缺失被拒；最后复位外门弟子。",
  "tags": [
    "sect",
    "gm"
  ],
  "pre_run_hook": {
    "command": "python3 \"$HOME/code/AstrBot/data/plugins/astrbot_plugin_monixiuxian2_2/scripts/test_suite_ctl.py\" fixture --profile sect --yes",
    "timeout": 60
  },
  "conversation": {
    "kind": "group",
    "group_id": "webtest_sect_011",
    "pin_players": {
      "gm": "900000001",
      "p1": "900000002"
    }
  },
  "steps": [
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 清除CD 900000002 确认",
      "note": "清理忙碌状态（防 run-all 跨用例污染）"
    },
    {
      "type": "expect",
      "match": "re:已清除【测试玩家1】的忙碌状态|不在任何忙碌状态",
      "timeout": 10
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置职位 900000002 0",
      "note": "数字职位：宗主"
    },
    {
      "type": "expect",
      "match": "re:职位设置为「宗主」",
      "timeout": 10
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#宗门 信息",
      "note": "职位展示"
    },
    {
      "type": "expect",
      "match": "re:宗门信息[\\s\\S]*你的职位：宗主",
      "timeout": 10
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#宗门 晋升",
      "note": "宗主无晋升通道"
    },
    {
      "type": "expect",
      "match": "re:你已是一宗之主，无需晋升！",
      "timeout": 10
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置职位 900000002 亲传弟子",
      "note": "中文职位名映射"
    },
    {
      "type": "expect",
      "match": "re:职位设置为「亲传弟子」",
      "timeout": 10
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#宗门 晋升",
      "note": "亲传→长老门槛：贡献 30000/9 级，fixture 预置 2500/2 级双缺失"
    },
    {
      "type": "expect",
      "match": "re:晋升【长老】未达门槛：[\\s\\S]*贡献不足（2500/30000）[\\s\\S]*境界不足（需达到练气九阶）",
      "timeout": 10
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置职位 900000002 4",
      "note": "复位外门弟子"
    },
    {
      "type": "expect",
      "match": "re:职位设置为「外门弟子」",
      "timeout": 10
    }
  ]
}
