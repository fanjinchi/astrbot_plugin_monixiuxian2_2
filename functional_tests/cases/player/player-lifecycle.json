{
  "name": "player-lifecycle",
  "description": "验证新玩家主循环：创建角色→查看信息→闭关→重复闭关拦截→出关（不足1分钟不结算）。",
  "scenario": "前置条件：无（运行器使用全新私聊玩家）。覆盖：玩家创建/选择灵修/信息查看/闭关状态机/忙碌拦截/出关结算。",
  "tags": [
    "player",
    "cultivation",
    "core-smoke"
  ],
  "conversation": {
    "kind": "private",
    "pin_players": {}
  },
  "steps": [
    {
      "type": "send",
      "player": "player1",
      "text": "我要修仙",
      "note": "进入创建引导"
    },
    {
      "type": "expect",
      "match": "欢迎踏入修仙之路",
      "timeout": 30,
      "note": "应提示选择修炼方式"
    },
    {
      "type": "send",
      "player": "player1",
      "text": "我要修仙 灵修",
      "note": "创建灵修角色"
    },
    {
      "type": "expect",
      "match": "恭喜道友",
      "timeout": 30,
      "note": "角色创建成功"
    },
    {
      "type": "send",
      "player": "player1",
      "text": "我的信息",
      "note": "查看角色信息"
    },
    {
      "type": "expect",
      "match": "道友",
      "timeout": 30,
      "note": "信息面板可访问"
    },
    {
      "type": "send",
      "player": "player1",
      "text": "闭关",
      "note": "进入闭关状态"
    },
    {
      "type": "expect",
      "match": "已进入闭关状态",
      "timeout": 30,
      "note": "状态切换为修炼中"
    },
    {
      "type": "send",
      "player": "player1",
      "text": "闭关",
      "note": "重复闭关应被拦截"
    },
    {
      "type": "expect",
      "match": "无法分心他顾",
      "timeout": 30,
      "note": "忙碌状态防重入"
    },
    {
      "type": "send",
      "player": "player1",
      "text": "出关",
      "note": "立即出关"
    },
    {
      "type": "expect",
      "match": "不足1分钟",
      "timeout": 30,
      "note": "未满足时长不结算修为"
    }
  ]
}
