{
  "name": "pvp-effect-pierce",
  "description": "验证 pierce：破军诀「破军一击」穿透护甲。",
  "scenario": "固定群聊双玩家，p2 装备泰坦之铠，p1 激活破军诀后决斗；引擎无穿透专用文本，结果依赖伤害数值与原始轨迹，需 --repeat 聚合。",
  "tags": [
    "pvp",
    "effect-matrix",
    "content-design",
    "sampled"
  ],
  "conversation": {
    "kind": "group",
    "group_id": "webtest_pvp_001",
    "pin_players": {
      "gm": "900000001",
      "p1": "900000002",
      "p2": "900000003"
    }
  },
  "steps": [
    {
      "type": "send",
      "player": "p1",
      "text": "#我要修仙 灵修",
      "note": "创建 p1"
    },
    {
      "type": "expect",
      "match": "re:恭喜道友|已踏入仙途",
      "timeout": 60,
      "note": "p1 可用"
    },
    {
      "type": "send",
      "player": "p2",
      "text": "#我要修仙 灵修",
      "note": "创建 p2"
    },
    {
      "type": "expect",
      "match": "re:恭喜道友|已踏入仙途",
      "timeout": 60,
      "note": "p2 可用"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置攻击 900000002 200",
      "note": "设置攻击方攻击"
    },
    {
      "type": "expect",
      "match": "re:攻击设置为|已踏入",
      "timeout": 60,
      "note": "攻击方攻击设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置攻击 900000003 50",
      "note": "设置防守方攻击"
    },
    {
      "type": "expect",
      "match": "re:攻击设置为|已踏入",
      "timeout": 60,
      "note": "防守方攻击设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置气血 900000002 2000",
      "note": "设置攻击方气血"
    },
    {
      "type": "expect",
      "match": "re:气血设置为|已踏入",
      "timeout": 60,
      "note": "攻击方气血设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置气血 900000003 5000",
      "note": "设置防守方气血"
    },
    {
      "type": "expect",
      "match": "re:气血设置为|已踏入",
      "timeout": 60,
      "note": "防守方气血设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 给予装备 900000003 泰坦之铠 1",
      "note": "p2 获得高护甲"
    },
    {
      "type": "expect",
      "match": "re:已向|已踏入",
      "timeout": 60,
      "note": "p2 护甲发放"
    },
    {
      "type": "send",
      "player": "p2",
      "text": "#装备 泰坦之铠",
      "note": "p2 装备护甲"
    },
    {
      "type": "expect",
      "match": "已装备",
      "timeout": 60,
      "note": "p2 护甲装备成功"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#激活功法 破军诀",
      "note": "p1 激活 破军诀"
    },
    {
      "type": "expect",
      "match": "已激活",
      "timeout": 60,
      "note": "破军诀 激活成功"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#决斗 900000003",
      "note": "pierce 无专用日志；通过高护甲下伤害表现与 --repeat 原始轨迹人工/脚本核对"
    },
    {
      "type": "expect",
      "match": "re:发起攻击|暴击|战斗开始",
      "timeout": 60,
      "note": "pierce 无专用日志；通过高护甲下伤害表现与 --repeat 原始轨迹人工/脚本核对"
    }
  ]
}
