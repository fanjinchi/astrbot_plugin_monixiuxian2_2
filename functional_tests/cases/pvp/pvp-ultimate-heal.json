{
  "name": "pvp-ultimate-heal",
  "description": "验证治疗大招：回天圣手恢复气血。",
  "scenario": "固定群聊双玩家，p1 激活回天圣手与 p2 长线战斗，断言「施展大招【回天圣手】，天地变色！」；min_action_index=3，声明 deterministic: true + seed（确定性优先），必要时 --repeat 采样兜底。",
  "tags": [
    "pvp",
    "effect-matrix",
    "content-design",
    "sampled"
  ],
  "deterministic": true,
  "seed": 42,
  "conversation": {
    "kind": "group",
    "group_id": "webtest_pvp_001",
    "pin_players": {
      "gm": "900000001",
      "p1": "900000002",
      "p2": "900000003"
    }
  },
  "steps": [
    {
      "type": "send",
      "player": "p1",
      "text": "#我要修仙 灵修",
      "note": "创建 p1"
    },
    {
      "type": "expect",
      "match": "re:恭喜道友|已踏入仙途",
      "timeout": 60,
      "note": "p1 可用"
    },
    {
      "type": "send",
      "player": "p2",
      "text": "#我要修仙 灵修",
      "note": "创建 p2"
    },
    {
      "type": "expect",
      "match": "re:恭喜道友|已踏入仙途",
      "timeout": 60,
      "note": "p2 可用"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置攻击 900000002 200",
      "note": "设置攻击方攻击"
    },
    {
      "type": "expect",
      "match": "re:攻击设置为|已踏入",
      "timeout": 60,
      "note": "攻击方攻击设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置攻击 900000003 200",
      "note": "设置防守方攻击"
    },
    {
      "type": "expect",
      "match": "re:攻击设置为|已踏入",
      "timeout": 60,
      "note": "防守方攻击设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置气血 900000002 3000",
      "note": "设置攻击方气血"
    },
    {
      "type": "expect",
      "match": "re:气血设置为|已踏入",
      "timeout": 60,
      "note": "攻击方气血设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置气血 900000003 10000",
      "note": "设置防守方气血"
    },
    {
      "type": "expect",
      "match": "re:气血设置为|已踏入",
      "timeout": 60,
      "note": "防守方气血设置成功"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#激活功法 回天圣手",
      "note": "p1 激活 回天圣手"
    },
    {
      "type": "expect",
      "match": "已激活",
      "timeout": 60,
      "note": "回天圣手 激活成功"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#决斗 900000003",
      "note": "ultimate heal（min_action=3）"
    },
    {
      "type": "expect",
      "match": "re:施展大招【回天圣手】|战斗开始",
      "timeout": 60,
      "note": "ultimate heal（min_action=3）"
    }
  ]
}
