{
  "name": "pvp-effect-combo",
  "description": "验证 combo 连击：狂风诀「惊风连击」与伤害倍率。",
  "scenario": "固定群聊双玩家，p1 激活狂风诀后决斗 p2；combo 与 damage_bonus 共用「攻势更盛！」日志，概率触发需 --repeat。",
  "tags": [
    "pvp",
    "effect-matrix",
    "content-design",
    "sampled"
  ],
  "conversation": {
    "kind": "group",
    "group_id": "webtest_pvp_001",
    "pin_players": {
      "gm": "900000001",
      "p1": "900000002",
      "p2": "900000003"
    }
  },
  "steps": [
    {
      "type": "send",
      "player": "p1",
      "text": "#我要修仙 灵修",
      "note": "创建 p1"
    },
    {
      "type": "expect",
      "match": "re:恭喜道友|已踏入仙途",
      "timeout": 60,
      "note": "p1 可用"
    },
    {
      "type": "send",
      "player": "p2",
      "text": "#我要修仙 灵修",
      "note": "创建 p2"
    },
    {
      "type": "expect",
      "match": "re:恭喜道友|已踏入仙途",
      "timeout": 60,
      "note": "p2 可用"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置攻击 900000002 200",
      "note": "设置攻击方攻击"
    },
    {
      "type": "expect",
      "match": "re:攻击设置为|已踏入",
      "timeout": 60,
      "note": "攻击方攻击设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置攻击 900000003 50",
      "note": "设置防守方攻击"
    },
    {
      "type": "expect",
      "match": "re:攻击设置为|已踏入",
      "timeout": 60,
      "note": "防守方攻击设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置气血 900000002 2000",
      "note": "设置攻击方气血"
    },
    {
      "type": "expect",
      "match": "re:气血设置为|已踏入",
      "timeout": 60,
      "note": "攻击方气血设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置气血 900000003 5000",
      "note": "设置防守方气血"
    },
    {
      "type": "expect",
      "match": "re:气血设置为|已踏入",
      "timeout": 60,
      "note": "防守方气血设置成功"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#激活功法 狂风诀",
      "note": "p1 激活 狂风诀"
    },
    {
      "type": "expect",
      "match": "已激活",
      "timeout": 60,
      "note": "狂风诀 激活成功"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#决斗 900000003",
      "note": "combo 触发文本（15% 概率，需 repeat）"
    },
    {
      "type": "expect",
      "match": "re:触发【惊风连击】|战斗开始",
      "timeout": 60,
      "note": "combo 触发文本（15% 概率，需 repeat）"
    }
  ]
}
