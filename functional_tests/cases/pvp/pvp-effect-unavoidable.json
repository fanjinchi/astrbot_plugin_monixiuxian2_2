{
  "name": "pvp-effect-unavoidable",
  "description": "验证 unavoidable：破风剑意「破风」使下次攻击必中。",
  "scenario": "固定群聊双玩家，p2 高身法制造闪避，p1 激活破风剑意后决斗；引擎无必中专用日志，通过多次运行检查是否出现「躲过了」作为反向证据。",
  "tags": [
    "pvp",
    "effect-matrix",
    "content-design",
    "sampled"
  ],
  "conversation": {
    "kind": "group",
    "group_id": "webtest_pvp_001",
    "pin_players": {
      "gm": "900000001",
      "p1": "900000002",
      "p2": "900000003"
    }
  },
  "steps": [
    {
      "type": "send",
      "player": "p1",
      "text": "#我要修仙 灵修",
      "note": "创建 p1"
    },
    {
      "type": "expect",
      "match": "re:恭喜道友|已踏入仙途",
      "timeout": 60,
      "note": "p1 可用"
    },
    {
      "type": "send",
      "player": "p2",
      "text": "#我要修仙 灵修",
      "note": "创建 p2"
    },
    {
      "type": "expect",
      "match": "re:恭喜道友|已踏入仙途",
      "timeout": 60,
      "note": "p2 可用"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置攻击 900000002 200",
      "note": "设置攻击方攻击"
    },
    {
      "type": "expect",
      "match": "re:攻击设置为|已踏入",
      "timeout": 60,
      "note": "攻击方攻击设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置攻击 900000003 50",
      "note": "设置防守方攻击"
    },
    {
      "type": "expect",
      "match": "re:攻击设置为|已踏入",
      "timeout": 60,
      "note": "防守方攻击设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置气血 900000002 2000",
      "note": "设置攻击方气血"
    },
    {
      "type": "expect",
      "match": "re:气血设置为|已踏入",
      "timeout": 60,
      "note": "攻击方气血设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置气血 900000003 5000",
      "note": "设置防守方气血"
    },
    {
      "type": "expect",
      "match": "re:气血设置为|已踏入",
      "timeout": 60,
      "note": "防守方气血设置成功"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置精神力 900000003 2000",
      "note": "p2 高身法（高闪避）"
    },
    {
      "type": "expect",
      "match": "re:精神力设置为|已踏入",
      "timeout": 60,
      "note": "p2 身法设置成功"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#激活功法 破风剑意",
      "note": "p1 激活 破风剑意"
    },
    {
      "type": "expect",
      "match": "已激活",
      "timeout": 60,
      "note": "破风剑意 激活成功"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#决斗 900000003",
      "note": "unavoidable 无专用日志；重复运行中观察是否仍出现「躲过了」"
    },
    {
      "type": "expect",
      "match": "re:战斗开始",
      "timeout": 60,
      "note": "unavoidable 无专用日志；重复运行中观察是否仍出现「躲过了」"
    }
  ]
}
