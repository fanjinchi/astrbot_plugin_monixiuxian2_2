{
  "name": "pvp-ultimate-dot",
  "description": "验证 DOT 大招：九幽噬魂咒持续侵蚀。",
  "scenario": "固定群聊双玩家，p1 激活九幽噬魂咒与高气血 p2 长线战斗，断言「施展大招【九幽噬魂】，天地变色！」及后续「侵蚀」；min_action_index=4，声明 deterministic: true + seed（确定性优先）；本用例走单场必中口径，不依赖 --repeat 采样。断言锚在代码插值值（【技能名】/对战面板/回合行）而非文案字面量，并统一追加占位符残留负向断言（flavor-copy-assembly route A 回归）。pre_run_hook 跑 fixture --profile pvp 复位双方属性/冷却/功法位。",
  "tags": [
    "pvp",
    "effect-matrix",
    "content-design",
    "sampled",
    "narrative-flavor"
  ],
  "deterministic": true,
  "seed": 42,
  "conversation": {
    "kind": "group",
    "group_id": "webtest_pvp_001",
    "pin_players": {
      "gm": "900000001",
      "p1": "900000002",
      "p2": "900000003"
    }
  },
  "steps": [
    {
      "type": "send",
      "player": "p1",
      "text": "#我要修仙 灵修",
      "note": "创建 p1"
    },
    {
      "type": "expect",
      "match": "re:恭喜道友|已踏入仙途，无需重复此举",
      "timeout": 60,
      "note": "p1 可用"
    },
    {
      "type": "send",
      "player": "p2",
      "text": "#我要修仙 灵修",
      "note": "创建 p2"
    },
    {
      "type": "expect",
      "match": "re:恭喜道友|已踏入仙途，无需重复此举",
      "timeout": 60,
      "note": "p2 可用"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置攻击 900000002 200",
      "note": "设置攻击方攻击"
    },
    {
      "type": "expect",
      "match": "re:已将【[^】]*】的攻击设置为 200",
      "timeout": 60,
      "note": "GM 回执锚全串（攻击 200，去掉旧 `|已踏入` 假绿分支）"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置攻击 900000003 100",
      "note": "设置防守方攻击"
    },
    {
      "type": "expect",
      "match": "re:已将【[^】]*】的攻击设置为 100",
      "timeout": 60,
      "note": "GM 回执锚全串（攻击 100，去掉旧 `|已踏入` 假绿分支）"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置气血 900000002 8000",
      "note": "气血拉到 8000：战斗拉长到约 40 回合，触发率再低也必然命中"
    },
    {
      "type": "expect",
      "match": "re:已将【[^】]*】的气血设置为 8,000",
      "timeout": 60,
      "note": "GM 回执锚全串（气血 8,000，去掉旧 `|已踏入` 假绿分支）"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置气血 900000003 8000",
      "note": "气血拉到 8000：战斗拉长到约 40 回合，触发率再低也必然命中"
    },
    {
      "type": "expect",
      "match": "re:已将【[^】]*】的气血设置为 8,000",
      "timeout": 60,
      "note": "GM 回执锚全串（气血 8,000，去掉旧 `|已踏入` 假绿分支）"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#激活功法 九幽噬魂咒",
      "note": "p1 激活 九幽噬魂咒"
    },
    {
      "type": "expect",
      "match": "re:已激活功法【九幽噬魂咒】",
      "timeout": 60,
      "note": "激活回执锚全串（handlers/technique_handler.py:190），fixture 每轮重置 techniques 栏位，避免上轮激活残留"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#决斗 900000003",
      "note": "ultimate dot（min_action=4）"
    },
    {
      "type": "expect",
      "match": "re:测试玩家1[^\\n]*【九幽噬魂】",
      "combine": true,
      "timeout": 60,
      "note": "战报中出现「测试玩家1 …【九幽噬魂】」行（触发率 大招（第 4 次行动必放）；双方气血 8000 → 约 40 回合，单场不触发概率 <2%）。锚点用代码插值的技能名，不锚文案——文案改写不影响本断言"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#我的信息",
      "note": "哨兵发送：给负向断言制造一条新回复"
    },
    {
      "type": "expect_not",
      "match": "re:(?m)^-{3,}\\s*$|\\{[a-z_]+(:[^}]*)?\\}",
      "combine": true,
      "timeout": 60,
      "note": "回归守护：整轮回复不得残留未渲染占位符（{var} / {var:.1f}），也不得出现独占一行的「---」——后者是 copy_variants.csv 把剧情稿条目分隔线吞进 text 单元格造成的线上缺陷（narrative_config 5 条 + adventure desc_variants 15 条），命中即 bd astrbot_plugin_monixiuxian2_2-74n 未修"
    }
  ],
  "pre_run_hook": {
    "command": "python3 \"$HOME/code/AstrBot/data/plugins/astrbot_plugin_monixiuxian2_2/scripts/test_suite_ctl.py\" fixture --profile pvp --yes",
    "timeout": 90
  }
}
