{
  "name": "pvp-heart-passive",
  "description": "验证心法被动在战斗首行属性中生效：长春功气血+10%、疾风迅雷功迅捷+12%/身法+10%。",
  "scenario": "前置条件：固定群聊身份、GM 可用、fixture 已准备或步骤内创建。覆盖：主修心法被动、战斗首行属性、决斗。断言锚在代码插值值（【技能名】/对战面板/回合行）而非文案字面量，并统一追加占位符残留负向断言（flavor-copy-assembly route A 回归）。pre_run_hook 跑 fixture --profile pvp 复位双方属性/冷却/功法位。",
  "tags": [
    "pvp",
    "heart-method",
    "content-design",
    "narrative-flavor"
  ],
  "conversation": {
    "kind": "group",
    "group_id": "webtest_pvp_001",
    "pin_players": {
      "gm": "900000001",
      "p1": "900000002",
      "p2": "900000003"
    }
  },
  "steps": [
    {
      "type": "send",
      "player": "p1",
      "text": "#我要修仙 灵修",
      "note": "创建 p1"
    },
    {
      "type": "expect",
      "match": "re:恭喜道友|已踏入仙途，无需重复此举",
      "timeout": 30,
      "note": "p1 可用"
    },
    {
      "type": "send",
      "player": "p2",
      "text": "#我要修仙 灵修",
      "note": "创建 p2"
    },
    {
      "type": "expect",
      "match": "re:恭喜道友|已踏入仙途，无需重复此举",
      "timeout": 30,
      "note": "p2 可用"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置气血 900000002 8000",
      "note": "气血拉到 8000：战斗拉长到约 40 回合，触发率再低也必然命中"
    },
    {
      "type": "expect",
      "match": "re:已将【[^】]*】的气血设置为 8,000",
      "timeout": 30,
      "note": "GM 回执锚全串（气血 8,000，去掉旧 `|已踏入` 假绿分支）"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#装备 长春功",
      "note": "装备主修心法"
    },
    {
      "type": "expect",
      "match": "已装备",
      "timeout": 30,
      "note": "心法装备成功"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#决斗 900000003",
      "note": "p1 带长春功战斗"
    },
    {
      "type": "expect",
      "match": "re:气血 8800/8800",
      "timeout": 60,
      "note": "长春功气血+10% 被动在战斗首行生效（基线 8000→8,800，代码拼装的对战面板）"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置真元 900000003 50",
      "note": "p2 基础迅捷"
    },
    {
      "type": "expect",
      "match": "re:真元设置为[^\\n]*50",
      "timeout": 30,
      "note": "p2 迅捷基数确定"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置精神力 900000003 50",
      "note": "p2 基础身法"
    },
    {
      "type": "expect",
      "match": "re:精神力设置为[^\\n]*50",
      "timeout": 30,
      "note": "p2 身法基数确定"
    },
    {
      "type": "send",
      "player": "gm",
      "text": "#修仙GM 设置境界 900000003 炼虚一阶",
      "note": "p2 提升到疾风迅雷功所需境界"
    },
    {
      "type": "expect",
      "match": "re:境界设置为[^\\n]*炼虚一阶",
      "timeout": 30,
      "note": "境界设置成功"
    },
    {
      "type": "send",
      "player": "p2",
      "text": "#装备 疾风迅雷功",
      "note": "p2 装备心法"
    },
    {
      "type": "expect",
      "match": "已装备",
      "timeout": 30,
      "note": "心法装备成功"
    },
    {
      "type": "send",
      "player": "p2",
      "text": "#决斗 900000002",
      "note": "p2 带疾风迅雷功战斗"
    },
    {
      "type": "expect",
      "match": "re:身法 55[\\s\\S]*迅捷 56",
      "timeout": 60,
      "note": "迅捷+12%/身法+10% 在战斗首行生效（50→56/55）"
    },
    {
      "type": "send",
      "player": "p1",
      "text": "#我的信息",
      "note": "哨兵发送：给负向断言制造一条新回复"
    },
    {
      "type": "expect_not",
      "match": "re:(?m)^-{3,}\\s*$|\\{[a-z_]+(:[^}]*)?\\}",
      "combine": true,
      "timeout": 60,
      "note": "回归守护：整轮回复不得残留未渲染占位符（{var} / {var:.1f}），也不得出现独占一行的「---」——后者是 copy_variants.csv 把剧情稿条目分隔线吞进 text 单元格造成的线上缺陷（narrative_config 5 条 + adventure desc_variants 15 条），命中即 bd astrbot_plugin_monixiuxian2_2-74n 未修"
    }
  ],
  "pre_run_hook": {
    "command": "python3 \"$HOME/code/AstrBot/data/plugins/astrbot_plugin_monixiuxian2_2/scripts/test_suite_ctl.py\" fixture --profile pvp --yes",
    "timeout": 90
  },
  "owner": "astrbot_plugin_monixiuxian2_2"
}
