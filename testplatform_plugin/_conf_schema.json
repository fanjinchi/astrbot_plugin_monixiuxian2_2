{
  "host": {
    "description": "Web 服务监听地址",
    "type": "string",
    "default": "127.0.0.1",
    "hint": "默认仅本机可访问。如需局域网访问请改为 0.0.0.0（建议同时设置访问令牌）。"
  },
  "port": {
    "description": "Web 服务端口",
    "type": "int",
    "default": 8765,
    "hint": "网页界面与 API 的访问端口。"
  },
  "access_token": {
    "description": "访问令牌",
    "type": "string",
    "default": "",
    "hint": "留空 = 本机免令牌访问。设置后所有 /api/* 与 WebSocket 请求必须携带令牌（Authorization: Bearer <token>），否则 401。"
  },
  "default_players": {
    "description": "默认模拟玩家",
    "type": "template_list",
    "default": [
      { "nickname": "测试玩家1", "user_id": "test_player_001" },
      { "nickname": "测试玩家2", "user_id": "test_player_002" }
    ],
    "template_schema": {
      "nickname": {
        "description": "昵称",
        "type": "string",
        "default": "测试玩家"
      },
      "user_id": {
        "description": "用户ID（稳定身份，插件按它键控玩家）",
        "type": "string",
        "default": "test_player_001"
      }
    },
    "hint": "新建私聊会话时的默认可选玩家；群聊会话可在建会话时自由指定成员。"
  }
}
